# ============================================================
#  Cantine de Vatel — variables d'environnement
#  Copier ce fichier :  copy .env.example .env
#  puis renseigner les valeurs reelles.
#  ATTENTION : .env ne doit JAMAIS etre commite (voir .gitignore)
# ============================================================

# ------------------------------------------------------------
# 1. Supabase — projet heberge (obligatoire)
#    Dashboard > Project Settings > API
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Cle publique "anon" / "publishable" — sans danger cote client,
# la securite repose sur les Row Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. Supabase CLI — usage local uniquement, jamais expose au front
#    Dashboard > Account > Access Tokens
# ------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxx
# SUPABASE_DB_PASSWORD=changeme

# ------------------------------------------------------------
# 3. Application (optionnel)
# ------------------------------------------------------------
VITE_APP_NAME="Cantine de Vatel"
VITE_APP_ENV=development

# ------------------------------------------------------------
# 4. Paiement Mobile Money simule (bonus) — valeurs de demonstration
# ------------------------------------------------------------
# VITE_MOBILE_MONEY_PROVIDER=wave
# VITE_MOBILE_MONEY_MERCHANT_ID=demo_merchant

# ------------------------------------------------------------
# 5. Assistant IA DeepSeek (bonus) - Vatel Smart Chef & Anti-Gaspillage
#    En production, la cle NE DOIT PAS etre ici : elle vit uniquement dans les
#    secrets Supabase, et le navigateur appelle la fonction Edge deepseek.
#      npx supabase secrets set DEEPSEEK_API_KEY=sk-... --project-ref <ref>
#    Cette variable n'est utile qu'en developpement, pour appeler DeepSeek en
#    direct si le proxy n'est pas deploye. Laisser vide si douteux : le moteur
#    local prend le relais sans aucune erreur visible.
# ------------------------------------------------------------
VITE_DEEPSEEK_API_KEY=